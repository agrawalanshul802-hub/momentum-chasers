
# ==============================================================================
# Momentum Chasers — Environment Configuration Template
# Copy this file to .env and insert your real credentials.
# ==============================================================================

PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE & AUTH CONFIGURATION
# Find these in your Supabase Project Settings -> API
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# ------------------------------------------------------------------------------
# 2. DHAN HQ API DIRECT CREDENTIALS & AUTOMATED TOTP (Zero Manual Login)
# ------------------------------------------------------------------------------
DHAN_CLIENT_ID=your_10_digit_dhan_client_id
DHAN_PIN=your_6_digit_dhan_pin
DHAN_TOTP_SECRET=your_totp_secret_key_from_dhan_profile
DHAN_KEY=your_dhan_jwt_token_optional

# ------------------------------------------------------------------------------
# 2. MULTI-API KEY POOL CONFIGURATION
# Add as many API keys as you have! The engine will round-robin load balance,
# monitor quotas, and automatically fail over if any key hits an HTTP 429 rate limit.
# ------------------------------------------------------------------------------

# Format: ID:PROVIDER:API_KEY:API_SECRET:RATE_LIMIT_PER_SEC
# Providers supported: dhan, angel, kite, upstox, yahoo
API_KEY_POOL=[
  {
    "id": "key_dhan_primary",
    "provider": "dhan",
    "apiKey": "your_dhan_client_id",
    "token": "your_dhan_access_token",
    "rateLimit": 10,
    "enabled": true
  },
  {
    "id": "key_angel_primary",
    "provider": "angel",
    "apiKey": "your_angel_smartapi_key",
    "token": "your_angel_jwt_token",
    "rateLimit": 3,
    "enabled": true
  },
  {
    "id": "key_kite_primary",
    "provider": "kite",
    "apiKey": "your_zerodha_api_key",
    "token": "your_kite_access_token",
    "rateLimit": 3,
    "enabled": true
  },
  {
    "id": "key_yahoo_fallback_1",
    "provider": "yahoo",
    "rateLimit": 5,
    "enabled": true
  },
  {
    "id": "key_yahoo_fallback_2",
    "provider": "yahoo",
    "rateLimit": 5,
    "enabled": true
  }
]

# ------------------------------------------------------------------------------
# 3. LIVE STREAMING & WEBSOCKET SETTINGS
# ------------------------------------------------------------------------------
CANDLE_TIMEFRAME=15m
EMAS_TRACKED=10,20,50,200
WS_HEARTBEAT_MS=15000

